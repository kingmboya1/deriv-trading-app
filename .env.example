# Deriv Trading Platform - Environment Variables Example
# Copy this file to .env.local and fill in your values

# ============================================
# DERIV OAUTH CONFIGURATION
# ============================================
# Get these from https://api.deriv.com/
NEXT_PUBLIC_DERIV_APP_ID=33MJcHX2yZOr6lkeIP9Mg
NEXT_PUBLIC_DERIV_REST_URL=https://api.derivws.com

# ============================================
# DEPLOYMENT URLs
# ============================================
# Local development
NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (update these with your actual Vercel URL)
# NEXT_PUBLIC_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ============================================
# BOT SERVER CONFIGURATION
# ============================================
# This variable is SERVER-SIDE ONLY (not exposed to browser)
# 
# Local development: Points to locally running bot server
BOT_SERVER_URL=http://localhost:3001
#
# Production: Set in Vercel environment variables to Railway/Render URL
# Example Railway: https://your-bot-server.railway.app
# Example Render:  https://your-bot-server.onrender.com

# ============================================
# NOTES
# ============================================
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - BOT_SERVER_URL is server-side only and never exposed to the browser
# - Remember to update OAuth redirect URI in Deriv app settings
# - See DEPLOYMENT.md for complete deployment instructions
